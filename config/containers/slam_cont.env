DB_HOST=localhost
ENCODERS_ENABLED=0
PUBLISH_LASER_STATIC_TF=0
# rf2o_laser_odometry control:
# auto = start only when ENCODERS_ENABLED=0.
# Keep this value aligned with bridge_rpi_direct.env; slam_cont does not read
# that file automatically.
START_RF2O=auto
# slam_toolbox runs in localization mode and publishes the map->odom transform.
# AMCL (nav_cont) requires an explicit /initialpose and does NOT replace this.
# Mapping can be started explicitly with run_mapping.sh.
START_SLAM_TOOLBOX=1
STATIC_TF_FILE=/app/static_tf.yaml
