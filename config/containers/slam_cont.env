DB_HOST=localhost
PUBLISH_LASER_STATIC_TF=0
STATIC_TF_FILE=/app/static_tf.yaml
# rf2o_laser_odometry kontrola:
# auto = pokreni samo ako ENCODERS_ENABLED=0 (prati stanje enkodera iz bridge_rpi_direct.env)
# 0    = nikad ne pokrećaj (enkoderi rade, štedi ~15% jednog CPU core-a)
# 1    = uvijek pokreni
START_RF2O=auto
ENCODERS_ENABLED=1
