DB_HOST=localhost
ENCODERS_ENABLED=0
PUBLISH_LASER_STATIC_TF=0
# rf2o_laser_odometry control:
# auto = start only when ENCODERS_ENABLED=0.
# Keep this value aligned with bridge_rpi_direct.env; slam_cont does not read
# that file automatically.
START_RF2O=auto
RF2O_LOG_LEVEL=error
# Default localization owner: Nav2 AMCL in nav_cont publishes map->odom.
# Keep slam_toolbox localization off by default to avoid two publishers for map->odom.
# Mapping can still be started explicitly with run_mapping.sh.
# Experimental slam_toolbox localization: set START_SLAM_TOOLBOX=1 here and
# NAV2_USE_AMCL=false in config/containers/nav_cont.env.
START_SLAM_TOOLBOX=0
STATIC_TF_FILE=/app/static_tf.yaml
