# Default runtime settings for robot_bridge when BRIDGE_MODE=rpi_direct.
# Override these values here if your wiring or drivetrain geometry differs.
AS5600_ADDR=0x36
DRV_AIN1_PIN=18
DRV_AIN2_PIN=23
DRV_BIN1_PIN=19
DRV_BIN2_PIN=24
DRV_SLEEP_PIN=17
# Encoders disabled: bridge will not open I2C encoder bus and will force
# open-loop /wheel_odom integration from /cmd_vel.
ENCODERS_ENABLED=0
I2C_BUS=1
I2C_MUX_ADDR=0x70
# Keep channels for real wheel odometry.
LEFT_MUX_CHANNEL=0
# This is effectively forced on when ENCODERS_ENABLED=0, even if left as 0.
OPEN_LOOP_ODOM_FROM_CMD=0
RIGHT_MUX_CHANNEL=4
RPI_LGPIO_CHIP=4
WHEEL_BASE_M=0.20
WHEEL_RADIUS_M=0.033
# Maximum physical velocities used to normalise cmd_vel → [-1,1] PWM duty cycle.
# MAX_ANGULAR_VEL should match the highest angular.z Foxglove/Nav2 ever sends.
# At 3.0 a Foxglove command of 1.0 rad/s only produces ~16% PWM (too weak to overcome
# static friction). 1.0 rad/s is a realistic physical max for this robot.
MAX_LINEAR_VEL=0.5
MAX_ANGULAR_VEL=1.0
