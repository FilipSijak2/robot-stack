# Default runtime settings for robot_bridge when BRIDGE_MODE=rpi_direct.
# Override these values here if your wiring or drivetrain geometry differs.
AS5600_ADDR=0x36
DRV_AIN1_PIN=18
DRV_AIN2_PIN=23
DRV_BIN1_PIN=19
DRV_BIN2_PIN=24
DRV_SLEEP_PIN=17
# Enable encoders so odometry is not forced to open-loop cmd_vel integration.
ENCODERS_ENABLED=1
I2C_BUS=1
I2C_MUX_ADDR=0x70
# Keep channels for real wheel odometry.
LEFT_MUX_CHANNEL=0
# Disable open-loop odometry to prevent fake motion in odom/map when motors slip or stall.
OPEN_LOOP_ODOM_FROM_CMD=0
RIGHT_MUX_CHANNEL=4
RPI_LGPIO_CHIP=4
WHEEL_BASE_M=0.20
WHEEL_RADIUS_M=0.033
# Maximum physical velocities used to normalise cmd_vel → [-1,1] PWM duty cycle.
# Increase MAX_ANGULAR_VEL if rotation is still weak; decrease if it overshoots.
MAX_LINEAR_VEL=0.5
MAX_ANGULAR_VEL=3.0
