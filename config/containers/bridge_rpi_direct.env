# Default runtime settings for robot_bridge when BRIDGE_MODE=rpi_direct.
# Override these values here if your wiring or drivetrain geometry differs.
AS5600_ADDR=0x36
DRV_AIN1_PIN=18
DRV_AIN2_PIN=23
DRV_BIN1_PIN=19
DRV_BIN2_PIN=24
DRV_SLEEP_PIN=17
# Encoders disabled: bridge will not open I2C encoder bus and will force
# open-loop /wheel_odom integration from /cmd_vel.
ENCODERS_ENABLED=0
I2C_BUS=1
I2C_MUX_ADDR=0x70
# Keep channels for real wheel odometry.
LEFT_MUX_CHANNEL=0
# Maximum physical velocities used to normalise cmd_vel → [-1,1] PWM duty cycle.
# MAX_ANGULAR_VEL is the physical angular speed that maps to 100% PWM.
# Lower value gives more PWM for the same angular.z; current bags show 30% PWM
# is not enough to overcome static friction during in-place turns.
MAX_ANGULAR_VEL=1.0
MAX_LINEAR_VEL=0.5
# Minimum non-zero motor command after cmd_vel normalization.
# Helps overcome static friction when low auto-mode velocities are too weak under load.
MIN_MOTOR_CMD=0.35
# Adaptive rotation power assist:
# compares requested angular.z with /imu/data gyro z and raises motor rotation duty
# only while the robot is not achieving the requested yaw rate.
POWER_ADAPT_ENABLED=1
POWER_ADAPT_IMU_TOPIC=/imu/data
POWER_ADAPT_MIN_ANGULAR=0.12
POWER_ADAPT_LOW_RATIO=0.55
POWER_ADAPT_HIGH_RATIO=1.15
POWER_ADAPT_MAX_BOOST=0.50
POWER_ADAPT_STEP_UP=0.01
POWER_ADAPT_STEP_DOWN=0.004
POWER_ADAPT_FEEDBACK_TIMEOUT_S=0.25
# This is effectively forced on when ENCODERS_ENABLED=0, even if left as 0.
OPEN_LOOP_ODOM_FROM_CMD=0
RIGHT_MUX_CHANNEL=4
RPI_LGPIO_CHIP=4
WHEEL_BASE_M=0.20
WHEEL_RADIUS_M=0.033
