# Default runtime settings for robot_bridge when BRIDGE_MODE=rpi_direct.
# Override these values here if your wiring or drivetrain geometry differs.
AS5600_ADDR=0x36
DRV_AIN1_PIN=18
DRV_AIN2_PIN=23
DRV_BIN1_PIN=19
DRV_BIN2_PIN=24
DRV_SLEEP_PIN=-1
ENCODERS_ENABLED=0
I2C_BUS=1
I2C_MUX_ADDR=0x70
# Encoder hardware is currently disabled (fallback mode).
# Keep channels for later return to real wheel odometry.
LEFT_MUX_CHANNEL=0
OPEN_LOOP_ODOM_FROM_CMD=1
RIGHT_MUX_CHANNEL=4
RPI_LGPIO_CHIP=4
WHEEL_BASE_M=0.20
WHEEL_RADIUS_M=0.033
