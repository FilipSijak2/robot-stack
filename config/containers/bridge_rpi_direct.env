# Default runtime settings for robot_bridge when BRIDGE_MODE=rpi_direct.
# Override these values here if your wiring or drivetrain geometry differs.
AS5600_ADDR=0x36
# Match HARDWARE_WIRING_GUIDE.md:
#   GPIO18/23 -> DRV8833 AIN1/AIN2 -> left motor
#   GPIO19/24 -> DRV8833 BIN1/BIN2 -> right motor
DRV_AIN1_PIN=18
DRV_AIN2_PIN=23
DRV_BIN1_PIN=19
DRV_BIN2_PIN=24
DRV_SLEEP_PIN=17
# Encoders disabled: bridge will not open I2C encoder bus and will force
# open-loop /wheel_odom integration from /cmd_vel.
ENCODERS_ENABLED=0
I2C_BUS=1
I2C_MUX_ADDR=0x70
# Keep channels for real wheel odometry.
LEFT_MUX_CHANNEL=0
# Maximum physical velocities used to normalise cmd_vel → [-1,1] PWM duty cycle.
# MAX_ANGULAR_VEL is the physical angular speed that maps to 100% PWM.
# Lower value gives more PWM for the same angular.z. The 2026-06-21 21:34/21:35
# bags showed final /cmd_vel already requesting reverse + turn, but the robot
# barely yawed. Bias open-loop mapping toward enough torque while Nav2 keeps
# angular.z slow.
MAX_ANGULAR_VEL=0.50
MAX_LINEAR_VEL=0.40
# Minimum non-zero motor command after cmd_vel normalization.
# High enough for slow turn commands to start moving the drivetrain, while Nav2
# and velocity_smoother still cap angular speed.
MIN_MOTOR_CMD=0.34
# Adaptive rotation power assist:
# Use the base_link yaw-rate after bias correction. /imu/data is in camera
# optical axes, where angular_velocity.z is not robot yaw.
POWER_ADAPT_ENABLED=1
POWER_ADAPT_IMU_TOPIC=/imu/base_link_corrected
POWER_ADAPT_MIN_ANGULAR=0.08
POWER_ADAPT_LOW_RATIO=0.55
POWER_ADAPT_HIGH_RATIO=1.15
POWER_ADAPT_MAX_BOOST=0.45
POWER_ADAPT_STEP_UP=0.012
POWER_ADAPT_STEP_DOWN=0.006
POWER_ADAPT_FEEDBACK_TIMEOUT_S=0.25
# Allow true in-place rotations from Nav2. Forward-arc assist made the robot
# take wide turning loops near goals, which triggered replanning and pose resets.
FORWARD_ARC_TURN_ENABLED=0
FORWARD_ARC_TURN_MIN_ANGULAR=0.06
FORWARD_ARC_TURN_MAX_LINEAR=0.02
FORWARD_ARC_TURN_INNER_CMD=0.18
# This is effectively forced on when ENCODERS_ENABLED=0, even if left as 0.
OPEN_LOOP_ODOM_FROM_CMD=0
RIGHT_MUX_CHANNEL=4
RPI_LGPIO_CHIP=4
WHEEL_BASE_M=0.20
WHEEL_RADIUS_M=0.033
