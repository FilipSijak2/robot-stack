BRIDGE_MODE=${BRIDGE_MODE:-serial_legacy}
SERIAL_PORT=${BRIDGE_SERIAL_DEVICE:-/dev/ttyACM0}
SERIAL_BAUD=${BRIDGE_SERIAL_BAUD:-115200}
IMU_TOPIC=${BRIDGE_IMU_TOPIC:-/imu/arduino}
RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION}
ROS_DOMAIN_ID=${ROS_DOMAIN_ID}
CYCLONEDDS_URI=${CYCLONEDDS_URI:-file:///etc/ros/cyclonedds.xml}
