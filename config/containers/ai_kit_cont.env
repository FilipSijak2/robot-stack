DISPLAY=${DISPLAY:-}
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}
UDEV=1
ROS_DOMAIN_ID=${ROS_DOMAIN_ID}
RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION}
CYCLONEDDS_URI=${CYCLONEDDS_URI:-file:///etc/ros/cyclonedds.xml}
# Set to 0 to run in passthrough mode (republish images without AI inference).
# Set to 1 and configure HAILO_GST_PIPELINE to enable Hailo inference.
# Example:
#   HAILO_GST_PIPELINE=appsrc name=ros_src ! videoconvert ! hailonet hef-path=... ! hailofilter so-path=... ! appsink name=ros_sink emit-signals=true
AI_KIT_REQUIRE_HAILO=0
HAILO_GST_PIPELINE=${HAILO_GST_PIPELINE:-}
