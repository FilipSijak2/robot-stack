# Runtime configuration for cmd_vel_safety_filter.
#
# Purpose:
# - reverse motion is allowed, including reverse arcs,
# - reverse speed is capped at the same configured Nav2 linear speed,
# - collision monitor / costmaps are responsible for obstacle awareness.

CMD_VEL_SAFETY_INPUT=/cmd_vel_muxed
CMD_VEL_SAFETY_OUTPUT=/cmd_vel
CMD_VEL_SAFETY_STATUS=/cmd_vel_safety_status
CMD_VEL_REVERSE_MAX_SPEED=0.22
CMD_VEL_FORBID_REVERSE_TURNING=0
CMD_VEL_ANGULAR_DEADBAND=0.0001
CMD_VEL_PUBLISH_UNCHANGED_STATUS=0
