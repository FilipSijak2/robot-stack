RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION}
ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}
CYCLONEDDS_URI=${CYCLONEDDS_URI:-file:///etc/ros/cyclonedds.xml}
LOG_DIR=/logs
LIDAR_DEVICE=${LIDAR_DEVICE:-/dev/ttyUSB0}
BRIDGE_SERIAL_DEVICE=${BRIDGE_SERIAL_DEVICE:-/dev/ttyACM0}
CAMERA_DEVICE=${CAMERA_DEVICE:-/dev/video0}
HEALTHCHECK_LOG_TO_FILE=0
