BAG_OUTPUT_DIR=/bags
BAG_WORK_DIR=/bags_in_progress
# Keep each MCAP self-contained for Foxglove. ros2 bag split files do not
# repeat transient /map and /tf_static messages in later chunks, so later split
# files cannot render map-frame scans/paths when opened by themselves.
MAX_BAG_MB=512
SESSION_DURATION_S=40
STORAGE_BACKEND=mcap
COMPRESSION_MODE=none
TOPICS_FILE=/config/recorded_topics.yaml
