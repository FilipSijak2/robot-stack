FOXGLOVE_ADDRESS=0.0.0.0
FOXGLOVE_PORT=8765
FOXGLOVE_TLS=0
FOXGLOVE_TLS_CERT=/etc/ssl/certs/foxglove_bridge.crt
FOXGLOVE_TLS_KEY=/etc/ssl/private/foxglove_bridge.key
# Navigation, controls, IMU and compressed color remain available. Do not let
# saved Foxglove panels subscribe to raw images, depth or camera point clouds.
# Diagnostic override: FOXGLOVE_TOPIC_WHITELIST='[".*"]'
FOXGLOVE_TOPIC_WHITELIST='["^/(?!camera/).*","^/camera/[^/]+/color/(image_raw/compressed|image_compressed)$","^/camera/[^/]+/(imu|gyro/sample|accel/sample|[^/]+/camera_info)$"]'
# Humble does not provide the newer type_description_interfaces service type.
FOXGLOVE_SERVICE_WHITELIST='["^/(?!.*get_type_description$).*"]'
# Connection graph introspection is optional; topic/service/parameter access stays on.
# Add "connectionGraph" temporarily when inspecting the ROS graph.
FOXGLOVE_CAPABILITIES='["clientPublish","parameters","parametersSubscribe","services","assets"]'
