RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION}
ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}
CYCLONEDDS_URI=${CYCLONEDDS_URI:-file:///etc/ros/cyclonedds.xml}
FOXGLOVE_PORT=${FOXGLOVE_PORT:-8765}
FOXGLOVE_ADDRESS=${FOXGLOVE_ADDRESS:-0.0.0.0}
FOXGLOVE_TLS=${FOXGLOVE_TLS:-0}
FOXGLOVE_TLS_CERT=${FOXGLOVE_TLS_CERT:-/etc/ssl/certs/foxglove_bridge.crt}
FOXGLOVE_TLS_KEY=${FOXGLOVE_TLS_KEY:-/etc/ssl/private/foxglove_bridge.key}
