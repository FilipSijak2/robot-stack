SF_EKF_CONFIG=/app/robot_localization.yaml
SF_IMU_BASE_TOPIC=/imu/base_link
SF_IMU_YAW_CORRECTION_ENABLED=true
SF_IMU_CORRECTOR_INPUT_TOPIC=/imu/base_link
SF_IMU_CORRECTOR_OUTPUT_TOPIC=/imu/base_link_corrected
SF_IMU_CORRECTOR_CMD_TOPIC=/cmd_vel_collision_in
SF_IMU_CORRECTOR_MIN_SAMPLES=150
SF_IMU_CORRECTOR_STARTUP_TIMEOUT_S=5.0
SF_IMU_CORRECTOR_CMD_TIMEOUT_S=0.75
SF_IMU_CORRECTOR_CMD_LINEAR_THRESHOLD=0.015
SF_IMU_CORRECTOR_CMD_ANGULAR_THRESHOLD=0.03
SF_IMU_CORRECTOR_STATIONARY_GYRO_THRESHOLD=0.08
SF_IMU_CORRECTOR_ZERO_CLAMP_THRESHOLD=0.018
SF_IMU_CORRECTOR_BIAS_ALPHA=0.002
SF_IMU_CORRECTOR_BIAS_LIMIT=0.15
SF_IMU_CORRECTOR_YAW_RATE_VARIANCE=0.02
SF_IMU_CORRECTOR_PUBLISH_UNCALIBRATED=false
