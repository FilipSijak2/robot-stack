CMD_VEL_AUTO=/cmd_vel_auto
CMD_VEL_JOY=/cmd_vel_joy
CMD_VEL_OUT=/cmd_vel
ENABLE_CMD_VEL_MUX=1
ENABLE_JOYSTICK=1
JOYSTICK_DEV=/dev/input/js0
MANUAL_DEFAULT=false
MANUAL_TIMEOUT_S=0.5
# Scale factor for manual linear speed (cmd_vel_mux applies before bridge normalization).
# Foxglove teleop sends physical velocities (m/s, rad/s) up to whatever its panel max is.
MANUAL_SPEED_SCALE=0.5
# Independent scale for angular (rotation). Kept at 1.0 so full Foxglove stick → full
# bridge angular range. Tune separately from linear if rotation is too fast/slow.
MANUAL_ANGULAR_SCALE=1.0
