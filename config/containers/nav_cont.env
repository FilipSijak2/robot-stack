CMD_VEL_AUTO=/cmd_vel_auto
CMD_VEL_JOY=/cmd_vel_joy
CMD_VEL_OUT=/cmd_vel
ENABLE_CMD_VEL_MUX=1
ENABLE_COLLISION_MONITOR=1
COLLISION_MONITOR_PARAMS=/app/collision_monitor_params.yaml
CMD_VEL_COLLISION_IN=/cmd_vel_collision_in
ENABLE_CMD_VEL_SAFETY_FILTER=1
CMD_VEL_SAFETY_INPUT=/cmd_vel_safety_in
CMD_VEL_SAFETY_STATUS=/cmd_vel_safety_status
CMD_VEL_FORWARD_MAX_SPEED=0.22
CMD_VEL_REVERSE_MAX_SPEED=0.22
CMD_VEL_ANGULAR_MAX_SPEED=0.40
CMD_VEL_FORBID_REVERSE_TURNING=false
CMD_VEL_SCAN_STOP_ENABLED=true
CMD_VEL_SCAN_TOPIC=/scan_filtered
CMD_VEL_FRONT_STOP_DISTANCE=0.34
CMD_VEL_REAR_STOP_DISTANCE=0.24
CMD_VEL_SCAN_HALF_ANGLE_DEG=32.0
CMD_VEL_SCAN_MIN_POINTS=2
CMD_VEL_MAP_STOP_ENABLED=true
CMD_VEL_MAP_TOPIC=/map
CMD_VEL_POSE_TOPIC=/amcl_pose
CMD_VEL_MAP_LOOKAHEAD_M=0.38
CMD_VEL_MAP_HALF_WIDTH_M=0.20
ENABLE_JOYSTICK=1
JOYSTICK_DEV=/dev/input/js0
# Independent scale for angular (rotation). Kept at 1.0 so full Foxglove stick → full
# bridge angular range. Tune separately from linear if rotation is too fast/slow.
MANUAL_ANGULAR_SCALE=1.0
MANUAL_DEFAULT=false
# Scale factor for manual linear speed (cmd_vel_mux applies before bridge normalization).
# Foxglove teleop sends physical velocities (m/s, rad/s) up to whatever its panel max is.
MANUAL_SPEED_SCALE=0.25
MANUAL_TIMEOUT_S=0.5
