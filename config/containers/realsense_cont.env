RS_ALIGN_DEPTH=true
RS_BASE_FRAME_ID=realsense_link
RS_CAMERA_NAME=realsense
RS_COLOR_PROFILE=424x240x15
# Depth stream na 10fps - costmap se updejta na 5Hz pa 15fps nema smisla.
# D455 ne podrzava 640x480x10; 848x480x10 je podrzan i izbjegava startup error.
RS_DEPTH_PROFILE=848x480x10
RS_GYRO_FPS=200
RS_ACCEL_FPS=100
RS_ENABLE_ACCEL=true
RS_ENABLE_COLOR=true
RS_ENABLE_DEPTH=true
RS_ENABLE_GYRO=true
RS_ENABLE_INFRA1=false
RS_ENABLE_INFRA2=false
# Pointcloud MORA biti uključen kako bi local/global costmap dobio 3D prepreke.
# Costmap je konfiguriran za /camera/realsense/depth/color/points u nav2_params.yaml.
RS_ENABLE_POINTCLOUD=true
