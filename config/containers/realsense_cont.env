RS_ALIGN_DEPTH=true
RS_BASE_FRAME_ID=realsense_link
RS_CAMERA_NAME=realsense
# Higher-resolution color improves YOLO masks and saved close-up evidence.
RS_COLOR_PROFILE=640x480x15
# The D455 supports 640x480 depth at 15/30/60/90 Hz, but not at 10 Hz.
# A 15 Hz stream leaves headroom for the 5 Hz costmap without unnecessary load.
RS_DEPTH_PROFILE=640x480x15
RS_GYRO_FPS=200
RS_ACCEL_FPS=100
RS_ENABLE_ACCEL=true
RS_ENABLE_COLOR=true
RS_ENABLE_DEPTH=true
RS_ENABLE_GYRO=true
RS_ENABLE_INFRA1=false
RS_ENABLE_INFRA2=false
# Point-cloud output must stay enabled for 3D obstacles in the local and global costmaps.
# nav2_params.yaml reads /camera/realsense/depth/color/points.
RS_ENABLE_POINTCLOUD=true
# Prevent Linux USB power management from suspending the D455 while streaming.
RS_DISABLE_USB_AUTOSUSPEND=true
# Exit the container when the ROS node remains alive but image frames stop.
# Docker restart: always then performs a clean camera reconnect.
RS_WATCHDOG_ENABLED=true
RS_WATCHDOG_STARTUP_TIMEOUT_S=60
RS_WATCHDOG_STALE_TIMEOUT_S=15
