RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION}
ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}
CYCLONEDDS_URI=${CYCLONEDDS_URI:-file:///etc/ros/cyclonedds.xml}
RS_CAMERA_NAME=realsense
RS_USB_PORT_ID=${REALSENSE_USB_PORT_ID:-}
RS_SERIAL=${REALSENSE_SERIAL:-}
RS_ENABLE_DEPTH=true
RS_ENABLE_COLOR=true
RS_ENABLE_INFRA1=false
RS_ENABLE_INFRA2=false
RS_ENABLE_GYRO=true
RS_ENABLE_ACCEL=true
RS_UNITE_IMU_METHOD=${RS_UNITE_IMU_METHOD:-linear_interpolation}
RS_BASE_FRAME_ID=${RS_BASE_FRAME_ID:-realsense_link}
RS_DEPTH_PROFILE=640x480x15
RS_COLOR_PROFILE=640x480x15
RS_ALIGN_DEPTH=true
RS_ENABLE_POINTCLOUD=false
RS_COMPRESSED_JPEG_QUALITY=${RS_COMPRESSED_JPEG_QUALITY:-40}
