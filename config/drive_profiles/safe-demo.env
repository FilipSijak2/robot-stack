# Conservative default profile. These parameters shape PWM transitions only;
# calibrated MIN_MOTOR_CMD and velocity mappings remain in the base bridge env.
DRIVE_PROFILE_NAME=safe-demo
MOTOR_SLEW_ENABLED=1
MOTOR_SLEW_RATE_UP=0.60
MOTOR_SLEW_RATE_DOWN=1.60
MOTOR_REVERSAL_NEUTRAL_S=0.20
MOTOR_IMMEDIATE_STOP=1
