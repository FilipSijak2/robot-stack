# Carpet rotation calibration on 2026-09-13 showed that 0.04, 0.07 and 0.10
# rad/s all plateaued at about 31% peak PWM and failed to rotate reliably.
# Map Nav2's 0.10 rad/s rotation to 40% base PWM and enable IMU adaptation for
# 0.07/0.10 rad/s commands. Linear mapping remains unchanged.
DRIVE_PROFILE_NAME=carpet
MAX_ANGULAR_VEL=0.25
POWER_ADAPT_MIN_ANGULAR=0.06
MOTOR_SLEW_ENABLED=1
MOTOR_SLEW_RATE_UP=0.80
MOTOR_SLEW_RATE_DOWN=1.60
MOTOR_REVERSAL_NEUTRAL_S=0.15
MOTOR_IMMEDIATE_STOP=1
