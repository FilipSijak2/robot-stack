# Angular command limit and IMU adaptation threshold for carpet calibration.
# With SI wheel mixing MAX_ANGULAR_VEL is a command limit, NOT rotation PWM
# gain. Recheck breakaway duty on both surfaces after updating the bridge.
DRIVE_PROFILE_NAME=carpet
MAX_ANGULAR_VEL=0.25
POWER_ADAPT_MIN_ANGULAR=0.06
MOTOR_SLEW_ENABLED=1
MOTOR_SLEW_RATE_UP=0.80
MOTOR_SLEW_RATE_DOWN=1.60
MOTOR_REVERSAL_NEUTRAL_S=0.15
MOTOR_IMMEDIATE_STOP=1
