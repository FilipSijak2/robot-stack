<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared CycloneDDS configuration for the stack.
     Pin DDS traffic to lo, ${PI_DDS_WIFI_INTERFACE} and
     ${PI_DDS_TAILSCALE_INTERFACE} to avoid arbitrary interface selection across
     wlan / tailscale / docker / bridge interfaces on the Pi host.
     Also include loopback so intra-host container traffic uses lo.
     Tailscale peer discovery is static because multicast discovery does not
     traverse Tailscale reliably.

     Render this file with scripts/render_cyclonedds_config.sh after changing
     JETSON_TAILSCALE_IP or interface names in .env. -->
<CycloneDDS xmlns="https://cdds.omg.org/schema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Domain id="any">
        <General>
            <Interfaces>
                <NetworkInterface name="lo" priority="default" multicast="default" />
                <NetworkInterface name="${PI_DDS_WIFI_INTERFACE}" priority="default" multicast="default" />
                <NetworkInterface name="${PI_DDS_TAILSCALE_INTERFACE}" priority="default" multicast="false" />
            </Interfaces>
            <AllowMulticast>true</AllowMulticast>
            <MaxMessageSize>65500B</MaxMessageSize>
            <FragmentSize>4000B</FragmentSize>
        </General>

        <Internal>
            <!-- Request at most the buffer size the host currently grants, instead
                 of repeatedly asking for 1 MiB and logging a warning every start. -->
            <SocketReceiveBufferSize min="default" max="425984B" />
            <Watermarks>
                <WhcHigh>500kB</WhcHigh>
                <WhcHighInit>30kB</WhcHighInit>
                <WhcAdaptive>true</WhcAdaptive>
            </Watermarks>
            <LivelinessMonitoring>true</LivelinessMonitoring>
            <MonitorPort>-1</MonitorPort>
        </Internal>

        <Discovery>
            <Peers>
                <!-- Jetson Orin over Tailscale -->
                <Peer Address="${JETSON_TAILSCALE_IP}" />
            </Peers>
            <ParticipantIndex>auto</ParticipantIndex>
            <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
            <SPDPMulticastAddress>239.255.0.1</SPDPMulticastAddress>
            <SPDPInterval>1s</SPDPInterval>
            <DefaultMulticastAddress>auto</DefaultMulticastAddress>
            <Ports>
                <Base>7400</Base>
                <DomainGain>250</DomainGain>
                <ParticipantGain>3</ParticipantGain>
                <MulticastMetaOffset>0</MulticastMetaOffset>
                <UnicastMetaOffset>10</UnicastMetaOffset>
                <MulticastDataOffset>1</MulticastDataOffset>
                <UnicastDataOffset>11</UnicastDataOffset>
            </Ports>
        </Discovery>

        <Tracing>
            <Verbosity>warning</Verbosity>
            <OutputFile>stdout</OutputFile>
        </Tracing>
    </Domain>
</CycloneDDS>
