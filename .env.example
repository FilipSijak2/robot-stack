# Container registry and image tags
REGISTRY_HOST=registry.example.com
IMAGE_OWNER=example
SLAM_TAG=latest
NAV_TAG=latest
DRIVER_TAG=latest
DB_TAG=latest
SENSOR_FUSION_TAG=latest
BRIDGE_TAG=latest
AI_KIT_TAG=latest
REALSENSE_TAG=latest
ROSBRIDGE_TAG=latest
BAG_RECORDER_TAG=latest
HEALTHCHECK_TAG=latest
FOXGLOVE_BRIDGE_TAG=latest

# Hardware
LIDAR_DEVICE=/dev/ttyUSB0
BRIDGE_MODE=rpi_direct
# Active drivetrain dynamics profile. Use scripts/select_drive_profile.sh;
# calibration-specific motor values will be added after physical measurements.
DRIVE_PROFILE=safe-demo
# Master switch: controls both PWM ramping and direction-reversal interlock.
MOTOR_SLEW_ENABLED=1
BRIDGE_SERIAL_DEVICE=/dev/ttyACM0
BRIDGE_SERIAL_BAUD=115200
BRIDGE_I2C_DEVICE=/dev/i2c-1
BRIDGE_GPIOMEM_DEVICE=/dev/gpiomem
BRIDGE_IMU_TOPIC=/imu/arduino
REALSENSE_USB_PORT_ID=
REALSENSE_SERIAL=
RS_UNITE_IMU_METHOD=linear_interpolation
RS_COMPRESSED_JPEG_QUALITY=75
CAMERA_DEVICE=/dev/video0

# ROS 2 and CycloneDDS
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///etc/ros/cyclonedds.xml
ENABLE_JETSON_DDS_PEER=0
JETSON_TAILSCALE_IP=
JETSON_DDS_DISCOVERY_PORT=7410
PI_DDS_WIFI_INTERFACE=wlan0
PI_DDS_TAILSCALE_INTERFACE=tailscale0
SF_IMU_INPUT_TOPIC=/camera/realsense/imu
SF_IMU_OUTPUT_TOPIC=/imu/data
SF_IMU_SOURCE=realsense

# Database: replace this value before deployment
DB_NAME=robot_data
DB_USER=robot_user
DB_PASS=change-me

# Runtime paths and logging
MAP_ROOT=/srv/maps
MAP_FILE=
MAPPING_MODE=0
COMPOSE_PROJECT_NAME=stack
DISPLAY=
XDG_RUNTIME_DIR=
HAILO_GST_PIPELINE=
RCUTILS_LOGGING_SEVERITY=INFO
RCUTILS_LOGGING_BUFFERED_STREAM=1
RCUTILS_LOGGING_USE_STDOUT=1
