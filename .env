# Example environment configuration for stack deployment
# Copy to .env and adjust values

# Registry hosting all images (host:port)
REGISTRY_HOST=100.67.134.63:5000
# Owner/namespace part used in image repository path
IMAGE_OWNER=filipsijak2

# Image tags (immutable release candidate tags recommended)
SLAM_TAG=slam-v25.42.rc5
NAV_TAG=nav-v25.42.rc5
DRIVER_TAG=laser_driver-v25.42.rc5
ROSBRIDGE_TAG=rosbridge-v25.42.rc5
DB_TAG=db-v25.42.rc5
SENSOR_FUSION_TAG=sensor_fusion-v25.42.rc5
BRIDGE_TAG=bridge-v25.42.rc5
AI_KIT_TAG=ai-kit-v25.43.rc1
CAMERA_TAG=camera-v25.43.rc34

# Hardware device paths
LIDAR_DEVICE=/dev/ttyUSB0
# Serial bridge (Nano ESP32 USB adapter path)
BRIDGE_SERIAL_DEVICE=/dev/ttyACM0
BRIDGE_SERIAL_BAUD=115200

# Performance tuning
ROS_DOMAIN_ID=0
RCUTILS_LOGGING_SEVERITY=INFO
RCUTILS_LOGGING_BUFFERED_STREAM=1
RCUTILS_LOGGING_USE_STDOUT=0

# DDS optimization for local network
CYCLONEDX_URI=file:///app/cyclonedds.xml
RMW_FASTRTPS_USE_QOS_FROM_XML=1

# Resource monitoring
ENABLE_PROFILING=false
LOG_LEVEL=INFO

# Database credentials (must match image init expectations)
DB_NAME=robot_data
DB_USER=robot_user
DB_PASS=robot_pass

# Map storage root inside containers (must be under mounted /srv)
MAP_ROOT=/srv/maps

# Active map selection (optional):
# Set MAP_SESSION to a session directory name under MAP_ROOT to auto-select its final/map.yaml.
# Or set MAP_FILE directly to an absolute path of a map yaml.
# Resolution order in start_nav.sh if MAP_FILE not set:
#   1) MAP_ROOT/MAP_SESSION/final/map.yaml
#   2) MAP_ROOT/MAP_SESSION/map.yaml
#   3) MAP_ROOT/active/final/map.yaml
#   4) MAP_ROOT/active/map.yaml
#   5) MAP_ROOT/latest/final/map.yaml
#   6) MAP_ROOT/latest/map.yaml
# If none found Nav2 uses yaml_filename from nav2_params.yaml.
# Example:
# MAP_SESSION=session_20251013-175951
# MAP_FILE=/srv/maps/session_20251013-175951/final/map.yaml

# MAP_SESSION=
# MAP_FILE=

# Optional: healthcheck timeouts (seconds)
HEALTH_RETRIES=5
HEALTH_DELAY=3

# Tailscale or external advertised host (for docs/logging)
PUBLIC_HOST=100.102.66.116